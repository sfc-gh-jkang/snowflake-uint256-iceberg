# Copy to .env and set for your own account. Nothing here is account-specific by design.
# scripts/render.sh refuses to run if any REQUIRED value is empty, because an empty
# substitution produces SQL that looks valid and is not.

# --- provider side ---
SNOWFLAKE_CONNECTION=my_provider_connection
DB=MY_DATABASE
SCHEMA=ETH_U256
WAREHOUSE=MY_WAREHOUSE
EXTERNAL_VOLUME=MY_EXTERNAL_VOLUME

# Consumer target for the private listing, as <ORG>.<ACCOUNT_NAME>
CONSUMER_ACCOUNT=MY_ORG.MY_CONSUMER_ACCOUNT

# --- consumer side ---
CONSUMER_CONNECTION=my_consumer_connection
CONSUMER_WAREHOUSE=MY_CONSUMER_WAREHOUSE
CONSUMER_DB=ETH_U256_CONSUMED
CONSUMER_SCHEMA=MY_DATABASE.U256_LOCAL

# Only known AFTER 04 runs. Read it from DESCRIBE LISTING, put it here, re-render for 05.
LISTING_GLOBAL_NAME=
